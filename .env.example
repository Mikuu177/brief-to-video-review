# Run python scripts/init_env.py first. Default: local single-user workspace, no login.
AUTH_MODE=local
DATABASE_URL=postgresql+psycopg://creator:creator@127.0.0.1:55432/creator_review
REDIS_URL=redis://127.0.0.1:56379/0
SESSION_SECRET=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
REVIEWER_USERNAME=reviewer
REVIEWER_PASSWORD=
POSTGRES_PASSWORD=
COOKIE_SECURE=false

# Configure on the server only. Do not paste keys into a browser or commit .env.
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# Optional numeric source IP for this Ark client only; blank uses normal routing.
# A local Wi-Fi address can change after reconnecting; do not copy another machine's IP.
ARK_LOCAL_ADDRESS=
ARK_TEXT_MODEL=
ARK_VIDEO_MODEL=
ARK_PREPROCESS_MODEL=
# Enable only after the real audio/video probe has been checked by human playback.
ARK_VIDEO_AUDIO_VERIFIED=false
ASR_API_KEY=
# Optional numeric source IP for speech submit/query; blank retains normal routing.
ASR_LOCAL_ADDRESS=
ASR_RESOURCE_ID=volc.seedasr.auc
TOS_ACCESS_KEY=
TOS_SECRET_KEY=
TOS_BUCKET=
TOS_REGION=cn-beijing
TOS_ENDPOINT=tos-cn-beijing.volces.com
# Optional numeric source IP for audio PUT only; SDK still signs the private URL.
# Blank retains the SDK upload path. TLS and Content-MD5 remain enabled.
TOS_LOCAL_ADDRESS=
STORAGE_BACKEND=local
REVIEW_WINDOW_MS=45000
REVIEW_OVERLAP_MS=5000
REVIEW_FULL_FPS=2
REVIEW_DETAIL_FPS=5
# Enable automatic AI_PASSED only after D6 real evaluation has met the frozen criteria.
REVIEW_LIVE_EVALUATION_APPROVED=false
PROVIDER_TIMEOUT_SECONDS=600
# Whole multi-stage job limit, separate from each individual provider request.
REVIEW_JOB_TIMEOUT_SECONDS=7200

# G0/G1 reading preview only; does not enable production approval.
SOURCE_INTEGRITY_ENABLED=true

# Independent video content reconstruction preview; not brand approval.
VIDEO_CONTENT_ENABLED=true
